rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function approvedGroupCreator() {
      return signedIn()
        && request.auth.token.email == 'mugalu2026@gmail.com';
    }

    function member(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)).data.status == 'active';
    }

    function leader(groupId) {
      return member(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)).data.leaderId == request.auth.uid;
    }

    function afterMember(groupId, userId) {
      return getAfter(/databases/$(database)/documents/groupMembers/$(groupId + '_' + userId)).data.status == 'active';
    }

    function afterLeader(groupId, userId) {
      return signedIn()
        && userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(groupId)).data.leaderId == request.auth.uid
        && afterMember(groupId, userId);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn()
        && request.auth.uid == userId
        && !('uid' in request.resource.data.diff(resource.data).changedKeys());
    }

    match /groups/{groupId} {
      allow read: if member(groupId);
      allow create: if approvedGroupCreator()
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.joinType in ['open', 'request', 'invite']
        && request.resource.data.isLocked == false;
      allow update: if leader(groupId)
        && request.resource.data.leaderId == resource.data.leaderId
        && request.resource.data.code == resource.data.code;
      allow delete: if leader(groupId);
    }

    match /groupJoinCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.code == code
        && request.resource.data.groupId is string
        && request.resource.data.joinType in ['open', 'request', 'invite']
        && afterLeader(request.resource.data.groupId, request.auth.uid)
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.code == code
        && request.resource.data.name == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.name
        && request.resource.data.maxMembers == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.maxMembers
        && request.resource.data.joinType == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.joinType
        && request.resource.data.isLocked == getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.isLocked;
      allow update: if leader(resource.data.groupId)
        && request.resource.data.code == resource.data.code
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.joinType in ['open', 'request', 'invite']
        && request.resource.data.name == getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.name
        && request.resource.data.maxMembers == getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.maxMembers
        && request.resource.data.joinType == getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.joinType
        && request.resource.data.isLocked == getAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.isLocked;
      allow delete: if leader(resource.data.groupId);
    }

    match /groupMembers/{id} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || member(resource.data.groupId));
      allow create: if signedIn()
        && id == request.resource.data.groupId + '_' + request.resource.data.userId
        && request.resource.data.status == 'active'
        && (
          (
            request.resource.data.userId == request.auth.uid
            && request.resource.data.role == 'member'
            && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.joinType == 'open'
            && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.isLocked == false
          )
          || (
            approvedGroupCreator()
            && request.resource.data.role == 'leader'
            && request.resource.data.userId == request.auth.uid
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.leaderId == request.auth.uid
          )
          || (
            leader(request.resource.data.groupId)
            && request.resource.data.role == 'member'
            && getAfter(/databases/$(database)/documents/joinRequests/$(request.resource.data.groupId + '_' + request.resource.data.userId)).data.status == 'approved'
          )
        );
      allow update: if signedIn()
        && leader(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.role == 'member'
        && request.resource.data.role == resource.data.role
        && request.resource.data.status in ['active', 'removed'];
      allow delete: if leader(resource.data.groupId);
    }

    match /joinRequests/{id} {
      allow create: if signedIn()
        && id == request.resource.data.groupId + '_' + request.resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.joinType == 'request'
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.isLocked == false;
      allow read: if leader(resource.data.groupId);
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'rejected'
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status == 'pending';
      allow update: if leader(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['approved', 'rejected'];
    }

    match /projects/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if (
        leader(request.resource.data.groupId)
        || afterLeader(request.resource.data.groupId, request.auth.uid)
      )
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId is string;
      allow update: if leader(resource.data.groupId)
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if leader(resource.data.groupId);
    }

    match /tasks/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if leader(request.resource.data.groupId);
      allow update: if member(resource.data.groupId)
        && (leader(resource.data.groupId) || resource.data.assignedTo == request.auth.uid);
      allow delete: if leader(resource.data.groupId);
    }

    match /notes/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId);
      allow update: if member(resource.data.groupId);
      allow delete: if leader(resource.data.groupId);
    }

    match /noteVersions/{id} {
      allow create: if signedIn()
        && member(get(/databases/$(database)/documents/notes/$(request.resource.data.noteId)).data.groupId);
      allow read: if signedIn()
        && member(get(/databases/$(database)/documents/notes/$(resource.data.noteId)).data.groupId);
    }

    match /activityLogs/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && (
          member(request.resource.data.groupId)
          || afterLeader(request.resource.data.groupId, request.auth.uid)
        );
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead']);
      allow create: if signedIn()
        && request.resource.data.type == 'taskAssigned'
        && leader(request.resource.data.groupId)
        && request.resource.data.userId != request.auth.uid
        && member(request.resource.data.groupId)
        && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.relatedId)).data.groupId == request.resource.data.groupId
        && getAfter(/databases/$(database)/documents/tasks/$(request.resource.data.relatedId)).data.assignedTo == request.resource.data.userId;
    }

    match /files/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId)
        && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if leader(resource.data.groupId) || resource.data.uploaderId == request.auth.uid;
    }

    match /discussionPosts/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if member(resource.data.groupId)
        && (resource.data.authorId == request.auth.uid || leader(resource.data.groupId));
    }

    match /comments/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if member(resource.data.groupId)
        && resource.data.authorId == request.auth.uid;
    }

    match /announcements/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if leader(request.resource.data.groupId);
      allow update, delete: if leader(resource.data.groupId);
    }

    match /submissions/{id} {
      allow read: if member(resource.data.groupId);
      allow create, update: if leader(request.resource.data.groupId);
    }
  }
}
