rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(groupId) { return signedIn() && exists(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)) && get(/databases/$(database)/documents/groupMembers/$(groupId + '_' + request.auth.uid)).data.status == 'active'; }
    function leader(groupId) { return member(groupId) && get(/databases/$(database)/documents/groups/$(groupId)).data.leaderId == request.auth.uid; }
    match /users/{userId} { allow create: if signedIn() && request.auth.uid == userId; allow read: if signedIn() && request.auth.uid == userId; allow update: if signedIn() && request.auth.uid == userId && !('uid' in request.resource.data.diff(resource.data).changedKeys()); }
    match /groups/{groupId} { allow read: if member(groupId); allow create: if signedIn() && request.resource.data.leaderId == request.auth.uid; allow update, delete: if leader(groupId); }
    match /groupMembers/{id} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || member(resource.data.groupId)); allow create: if signedIn() && (request.resource.data.userId == request.auth.uid || leader(request.resource.data.groupId)); allow update: if leader(resource.data.groupId); }
    match /joinRequests/{id} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read, update: if leader(resource.data.groupId); }
    match /tasks/{id} { allow read: if member(resource.data.groupId); allow create: if leader(request.resource.data.groupId); allow update: if member(resource.data.groupId) && (leader(resource.data.groupId) || resource.data.assignedTo == request.auth.uid); allow delete: if leader(resource.data.groupId); }
    match /notes/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId);
      allow update: if member(resource.data.groupId);
      allow delete: if leader(resource.data.groupId);
    }
    match /noteVersions/{id} {
      allow create: if signedIn() && member(get(/databases/$(database)/documents/notes/$(request.resource.data.noteId)).data.groupId);
      allow read: if signedIn() && member(get(/databases/$(database)/documents/notes/$(resource.data.noteId)).data.groupId);
    }
    match /activityLogs/{id} { allow read: if member(resource.data.groupId); allow create: if member(request.resource.data.groupId); }
    match /notifications/{id} { allow read, update: if signedIn() && resource.data.userId == request.auth.uid; }
    match /files/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId) && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if leader(resource.data.groupId) || resource.data.uploaderId == request.auth.uid;
    }
    match /discussionPosts/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if member(resource.data.groupId) && (resource.data.authorId == request.auth.uid || leader(resource.data.groupId));
    }
    match /comments/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if member(request.resource.data.groupId) && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if member(resource.data.groupId) && resource.data.authorId == request.auth.uid;
    }
    match /announcements/{id} {
      allow read: if member(resource.data.groupId);
      allow create: if leader(request.resource.data.groupId);
      allow update, delete: if leader(resource.data.groupId);
    }
    match /submissions/{id} {
      allow read: if member(resource.data.groupId);
      allow create, update: if leader(request.resource.data.groupId);
    }
  }
}
